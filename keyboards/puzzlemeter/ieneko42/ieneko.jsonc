      [ "KC_TRNS", "KC_F6", "KC_F7", "KC_F8", "KC_F9", "KC_F10", "KC_MINUS", "LSFT(KC_MINUS)", "KC_NO", "KC_NO", "KC_RSHIFT", "KC_LANG1" ],
