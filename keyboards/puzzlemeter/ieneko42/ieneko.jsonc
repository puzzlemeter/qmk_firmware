{
  "layout": [
/* Qwerty
 * ,------------------------------------------------------------------------------------------.
 * | Alt(~)  |   Q  |   W  |   E  |   R  |   T  |   Y  |   U  |   I  |   O  |  P   | Alt(\)   |
 * |---------+------+------+------+------+-------------+------+------+------+------+----------|
 * | CTRL    |   A  |   S  |   D  |   F  |   G  |   H  |   J  |   K  |   L  |  ;:  | CMD(')   |
 * |---------+------+------+------+------+------|------+------+------+------+------+----------|
 * | Shift(_)|   Z  |   X  |   C  |   V  |   B  |   N  |   M  |  ,<  |  .>  |  /?  |Shift(英数)|
 * `---------+------+------+------+------+------+------+------+------+------+------+----------'
 *                         | CMD  | Tab  |Space | Enter| Bksp |  =+  |
 *                         `-----------------------------------------'
 */
    [
      [ "LALT_T(KC_GRAVE)", "KC_Q", "KC_W", "KC_E", "KC_R", "KC_T", "KC_Y", "KC_U", "KC_I", "KC_O", "KC_P", "RALT_T(KC_BSLASH)" ],
